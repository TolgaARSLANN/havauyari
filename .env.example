# Kopyalayıp düzenleyin:  cp .env.example .env   (.env git dışıdır)

# docker compose'daki postgres servisi bu değerlerle kurulur
POSTGRES_USER=havauyari
POSTGRES_PASSWORD=havauyari
POSTGRES_DB=havauyari
POSTGRES_PORT=5432          # makinede açılan port (5432 doluysa değiştirin)
API_PORT=8000

# API'nin bağlandığı veritabanı. Compose içinde api servisi için otomatik olarak
# postgres servisine yönlendirilir; aşağıdaki değer yerelde (venv) çalıştırırken kullanılır.
# Tanımlı değilse API veritabanı olmadan, yalnızca bellek önbelleğiyle çalışır.
DATABASE_URL=postgresql://havauyari:havauyari@localhost:5432/havauyari

# DB entegrasyon testleri (pytest -m db) bu veritabanını kullanır ve tablolarını SİLER.
# Gerçek verinin olduğu veritabanını vermeyin; tanımlı değilse bu testler atlanır.
TEST_DATABASE_URL=postgresql://havauyari:havauyari@localhost:5432/havauyari_test
